{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@gui/*": ["../../cmd/obit-gui/frontend/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@radix-ui/react-dialog": ["./node_modules/@radix-ui/react-dialog"]
    }
  },
  "include": ["src", "playground", "vite.config.ts", "vite.playground.config.ts", "../../cmd/obit-gui/frontend/src/**/*"],
  "exclude": ["../../cmd/obit-gui/frontend/src/playground", "../../cmd/obit-gui/frontend/src/main.tsx"]
}

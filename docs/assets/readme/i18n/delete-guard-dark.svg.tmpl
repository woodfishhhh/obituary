<!-- Obituary delete-guard template: generate.py measures translated text before placing it.
     Layout rules: derive card widths from title and note text, keep 150px gaps,
     wrap bridge captions into lines above the arrow, keep titles >=22px and
     notes >=14px, and anchor the sparkle after the measured resurrection title. -->
<layout name="delete-guard" theme="dark" dynamic="true">
  <card role="delete" width="measure(guard-title, guard-first, command)" />
  <bridge caption="wrap(guard-bridge, gap - 24px)" />
  <card role="equivalent" width="measure(guard-equiv, guard-second, command)" />
  <card role="resurrect" width="measure(guard-res, guard-res-note, command, sparkle)" />
</layout>

<!-- Obituary lifecycle template: generate.py measures translated text before placing it.
     Layout rules: derive each card width from its longest label, keep 42px gaps,
     wrap only when measured text exceeds the card width, keep titles >=22px and
     notes >=14px, and anchor the sparkle after the measured resurrection title. -->
<layout name="lifecycle" theme="light-or-dark" dynamic="true">
  <card role="register" width="measure(register, register-note, command)" />
  <card role="expire" width="measure(expire, expire-note, command)" />
  <card role="bury" width="measure(bury, bury-note, command)" />
  <card role="resurrect" width="measure(resurrect, resurrect-note, command, sparkle)" />
  <card role="purge" width="match(resurrect)" />
  <footer before="measure(before)" commands="extend, spare" />
</layout>
